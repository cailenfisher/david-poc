# Local development (pnpm db:start, i.e. `supabase start`):
#   Run `pnpm db:start` (or `supabase status` once it's already running) and copy
#   its "API URL" and publishable key into the two values below.
#
# Hosted Supabase project — from Project Settings > API Keys instead.
#
# The publishable key (sb_publishable_…) replaces the legacy anon key, which
# Supabase is retiring at the end of 2026. It is safe to expose: it carries the
# same low privileges, and RLS is what actually restricts access.
#
# There is no DATABASE_URL. Nothing in this app opens a direct Postgres
# connection — all data access goes through the Supabase client, which means every
# query runs as the authenticated (or anon) role and is subject to RLS. A direct
# connection as the `postgres` role would own the tables and therefore bypass RLS
# entirely, which is exactly what this design avoids. `drizzle-kit generate` needs
# no connection either; it reads the TypeScript schema and emits SQL.
PUBLIC_SUPABASE_URL=your_supabase_project_url
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Required to sign in at all — the scaffold's only auth method is Google OAuth.
# Without these, the public route and the read-only /api/* endpoints still work
# locally, but everything under (admin) redirects to /sign-in and stays out of reach.
# See supabase/config.toml [auth.external.google] and README.md "Local development".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PUBLIC_DEFAULT_LOCALE=en
PUBLIC_SITE_URL=http://localhost:5173
